FROM optima-store:prev-20260928 AS deps
USER root
WORKDIR /src
COPY package.json package-lock.json* ./
ENV NODE_ENV=development
RUN npm ci

FROM optima-store:prev-20260928 AS builder
USER root
WORKDIR /src
COPY --from=deps /src/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_MIDTRANS_CLIENT_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=$NEXT_PUBLIC_MIDTRANS_CLIENT_KEY
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

FROM optima-store:prev-20260928 AS runner
USER root
WORKDIR /app
RUN rm -rf /app
COPY --from=builder --chown=nextjs:nodejs /src/.next/standalone /app
COPY --from=builder --chown=nextjs:nodejs /src/.next/static /app/.next/static
USER nextjs
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["node", "server.js"]
